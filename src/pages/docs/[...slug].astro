---
import { getCollection, render } from 'astro:content';
import ApiTable from '../../components/ApiTable.astro';
import RelatedPatterns from '../../components/RelatedPatterns.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docGroup, docSlug, type DocEntry } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
const isComponent = docGroup(entry) === 'components';
const tag = entry.data.tag;
const pageHeadings = isComponent
  ? [
      ...headings,
      ...(tag ? [{ depth: 2, slug: 'api-reference', text: 'API reference' }] : []),
      { depth: 2, slug: 'related-patterns', text: 'Related patterns' },
    ]
  : headings;
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={pageHeadings}>
  <header>
    <h1 class="page-title">{entry.data.title}</h1>
    <p class="page-description">{entry.data.description}</p>
    {
      isComponent && (
        <div class="page-meta">
          {tag && <span class="chip">&lt;{tag}&gt;</span>}
          <a class="chip" href={`https://github.com/tweakpad/ui/blob/development/docs/${docSlug(entry)}.md`}>
            Reference docs ↗
          </a>
        </div>
      )
    }
  </header>
  <div class="prose" style="margin-block-start: 2.5rem">
    <Content />
    {
      isComponent && tag && (
        <>
          <h2 id="api-reference">API reference</h2>
          <ApiTable tag={tag} />
        </>
      )
    }
    {
      isComponent && (
        <>
          <h2 id="related-patterns">Related patterns</h2>
          <p>Compositions that use this component. Open one to see how the pieces fit together.</p>
          <RelatedPatterns component={docSlug(entry)} />
        </>
      )
    }
  </div>
</DocsLayout>
