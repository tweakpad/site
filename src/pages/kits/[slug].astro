---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await getCollection('kits');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'kits'> };
const { Content } = await render(entry);
const statusLabel = { planned: 'In planning', preview: 'Preview', stable: 'Stable' }[entry.data.status];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <SectionHeader
    eyebrow={`Kit · ${statusLabel}`}
    title={entry.data.title}
    lede={entry.data.description}
    accent={entry.data.accent}
  />
  <div class="container kit" style={`--accent: ${entry.data.accent}`}>
    <div class="prose">
      <Content />
    </div>
    <section>
      <h2>Controls</h2>
      <ul class="controls">
        {
          entry.data.controls.map((control) => (
            <li>
              <h3>{control.name}</h3>
              <p>{control.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
    <p class="back"><a href={url('/kits')}>← All kits</a></p>
  </div>
</BaseLayout>

<style>
  .kit {
    padding-block: 3rem 6rem;
  }

  section {
    margin-block-start: 3rem;
  }

  h2 {
    margin: 0 0 1.25rem;
    color: var(--tp-muted-foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--site-line);
    border-radius: var(--tp-radius-xl);
    background: var(--site-line);
    list-style: none;
  }

  .controls li {
    padding: 1.25rem;
    background: var(--tp-background);
  }

  .controls h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .controls h3::before {
    content: '';
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .controls p {
    margin: 0;
    color: var(--tp-muted-foreground);
    font-size: var(--tp-text-sm);
    line-height: 1.55;
  }

  .back {
    margin-block-start: 3rem;
    font-size: var(--tp-text-sm);
  }

  .back a {
    color: var(--tp-muted-foreground);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--tp-foreground);
  }
</style>
