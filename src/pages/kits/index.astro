---
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortedKits } from '../../lib/content';

// Kits stay in content so their plans are kept; the page shows a holding message for now.
const kits = await sortedKits();
---

<BaseLayout title="Kits" description="Specialized controls, compositions and themes for niche products.">
  <SectionHeader
    eyebrow="Kits · Coming soon"
    title="Built for one"
    outline="kind of product"
    lede="Kits extend the foundation with controls that only make sense in a specific environment, composed into a ready-to-extend template with a theme of its own."
  />
  <div class="container kits">
    <div class="notice" role="status">
      <p class="notice__title">We're building the first kits.</p>
      <p>
        {kits.map((kit) => kit.data.title).join(', ')} are on the way. Until then, the
        foundation components and patterns are ready to use.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .kits {
    padding-block: 3rem 6rem;
  }

  .notice {
    max-inline-size: 40rem;
    padding: 1.5rem 1.75rem;
    border: 1px dashed var(--tp-border);
    border-radius: var(--tp-radius-xl);
    background: var(--site-subtle);
  }

  .notice p {
    margin: 0;
    color: var(--tp-muted-foreground);
    line-height: 1.6;
  }

  .notice .notice__title {
    margin-block-end: 0.35rem;
    color: var(--tp-foreground);
    font-weight: 600;
  }
</style>
