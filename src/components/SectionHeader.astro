---
/**
 * A section's opening: a solid display line over an outlined one, revealed with the library's
 * Text motion. As a page-wide band by default; `embedded` fits it into a content column, such as
 * the article of the Docs landing page.
 */
interface Props {
  eyebrow: string;
  title: string;
  /** Second display line, drawn as an outline in the accent color. */
  outline?: string;
  lede?: string;
  /** Tints the eyebrow dot, the outline and the header glow, for example a kit's accent. */
  accent?: string;
  /** Sits inside a content column instead of spanning the page: no glow, type sized to the column. */
  embedded?: boolean;
}
const { eyebrow, title, outline, lede, accent, embedded = false } = Astro.props;
---

<section
  class:list={['section-header', { 'section-header--embedded': embedded }]}
  style={accent ? `--accent: ${accent}` : undefined}
>
  <div class:list={{ container: !embedded }}>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">
      <tp-text-motion split="words lines" mask="lines" reveal="up" stagger="60">{title}</tp-text-motion>
      {
        outline && (
          <tp-text-motion class="outline" split="words lines" mask="lines" reveal="up" stagger="60">
            {outline}
          </tp-text-motion>
        )
      }
    </h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>
